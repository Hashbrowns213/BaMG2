[sub_resource type="GDScript" id="GDScript_mknyt"]
script/source = "extends CharacterBody2D

# -----------------
# EXPORTS
# -----------------
@export var speed := 100.0
@export var max_health := 30
@export var melee_range := 50.0
@export var basic_cast_range := 80.0
@export var melee_scene: PackedScene
@export var basic_cast_scene: PackedScene
@export var retreat_distance := 100.0
@export var retreat_speed := 300.0
@export var retreat_pause := 0.5
@export var attack_cooldown := 1.5   # seconds
@export var i_frame_duration := 3.0  # 3 seconds of invincibility

# Melee spawn offsets
@export var melee_offset_left := Vector2(0, -110)
@export var melee_offset_right := Vector2(0, -110)

signal health_changed(current)
signal boss_died

# -----------------
# STATES
# -----------------
enum {
	STATE_CHASE,
	STATE_ATTACK,
	STATE_RETREAT,
	STATE_HIT,
	STATE_DEAD
}
var state = STATE_CHASE

# -----------------
# VARIABLES
# -----------------
var health: int
var player: Node2D = null
var retreat_target_x := 0.0
var retreat_timer := 0.0
var attack_timer := 0.0
var i_frame_timer := 0.0
var is_invincible := false

# BasicCast multiple spawn tracking
var basic_cast_spawn_count := 0
var basic_cast_max_spawn := 4  # total spawns per cast

# -----------------
# NODES
# -----------------
@onready var melee_spawn: Marker2D = $MeleeSpawn
@onready var anim_player: AnimationPlayer = $AnimationPlayer
@onready var sprite: AnimatedSprite2D = $AnimatedSprite2D
@onready var detection_area: Area2D = $DetectionArea
@onready var Hurtbox: Area2D = $Hurtbox
@onready var CollisionShape: CollisionShape2D = $CollisionShape2D

# -----------------
# READY
# -----------------
func _ready():
	health = max_health
	detection_area.body_entered.connect(_on_detection_body_entered)
	anim_player.animation_finished.connect(_on_animation_finished)
	Hurtbox.area_entered.connect(_on_hurtbox_area_entered)

# -----------------
# PHYSICS
# -----------------
func _physics_process(delta):
	if state == STATE_DEAD:
		return

	if player == null:
		velocity = Vector2.ZERO
		move_and_slide()
		return

	# Handle i-frames
	if is_invincible:
		i_frame_timer -= delta
		if i_frame_timer <= 0:
			is_invincible = false

	# Handle attack cooldown
	attack_timer -= delta

	match state:
		STATE_CHASE:
			_chase_player()
		STATE_ATTACK:
			velocity = Vector2.ZERO
			move_and_slide()
		STATE_RETREAT:
			_handle_retreat(delta)
		STATE_HIT:
			velocity = Vector2.ZERO
			move_and_slide()

# -----------------
# CHASE PLAYER
# -----------------
func _chase_player():
	if player == null:
		return

	var distance = global_position.distance_to(player.global_position)

	# Decide which attack to use
	if attack_timer <= 0:
		if distance <= melee_range:
			attack_timer = attack_cooldown
			_start_melee()
			return
		elif distance <= basic_cast_range:
			attack_timer = attack_cooldown
			_start_basic_cast()
			return

	# Otherwise move toward player
	var dir = sign(player.global_position.x - global_position.x)
	velocity.x = dir * speed
	move_and_slide()
	_play_animation(\"Move\")

	if dir != 0:
		sprite.flip_h = dir < 0

# -----------------
# MELEE ATTACK
# -----------------
func _start_melee():
	state = STATE_ATTACK
	_play_animation(\"Melee\")

func spawn_melee():
	if melee_scene == null:
		return

	var melee = melee_scene.instantiate()
	get_parent().add_child(melee)

	# Adjust spawn based on facing direction
	if sprite.flip_h:
		melee.global_position = global_position + melee_offset_left
	else:
		melee.global_position = global_position + melee_offset_right

	melee.scale.x = -1 if sprite.flip_h else 1
	melee.z_index = 10

	_start_retreat()

# -----------------
# BASIC CAST ATTACK
# -----------------
func _start_basic_cast():
	state = STATE_ATTACK
	basic_cast_spawn_count = 0  # reset counter
	_play_animation(\"BasicCast\")

# Call this method in AnimationPlayer Call Method track
func _spawn_basic_cast_step():
	if basic_cast_scene == null or player == null:
		return

	var cast = basic_cast_scene.instantiate()
	get_parent().add_child(cast)
	cast.global_position = player.global_position
	cast.z_index = 9

	basic_cast_spawn_count += 1

	# Only start retreat after last spawn
	if basic_cast_spawn_count == basic_cast_max_spawn:
		_start_retreat()

# -----------------
# RETREAT
# -----------------
func _start_retreat():
	state = STATE_RETREAT
	retreat_timer = retreat_pause

	if sprite.flip_h:
		retreat_target_x = global_position.x + retreat_distance
	else:
		retreat_target_x = global_position.x - retreat_distance

func _handle_retreat(delta):
	var dir = sign(retreat_target_x - global_position.x)
	velocity.x = dir * retreat_speed
	move_and_slide()
	_play_animation(\"Move\")

	if abs(global_position.x - retreat_target_x) < 5:
		velocity.x = 0
		retreat_timer -= delta
		if retreat_timer <= 0:
			state = STATE_CHASE

# -----------------
# DAMAGE / HIT
# -----------------
func _on_hurtbox_area_entered(area: Area2D):
	if state == STATE_DEAD or is_invincible:
		return

	var damage: int = 0

	if area.is_in_group(\"player_hitbox\"):
		# Normal melee/ability attack
		damage = Stats.player_stats[\"attack\"]

	elif area.is_in_group(\"Projectile\"):
		# Projectile attack: get the damage from Stats based on projectile name
		if Stats.player_stats.has(area.name):
			damage = Stats.player_stats[area.name]
		else:
			# fallback in case the projectile name isn't in Stats
			damage = Stats.player_stats[\"attack\"]

	else:
		# Not a player attack or projectile, ignore
		return

	# Apply damage
	health -= damage
	health_changed.emit(health)
	print(\"Boss HP:\", health, \"(-\" + str(damage) + \")\")

	# Start i-frames
	is_invincible = true
	i_frame_timer = i_frame_duration

	if health <= 0:
		state = STATE_DEAD
		CollisionShape.disabled = true
		_play_animation(\"Death\")
	else:
		state = STATE_HIT
		_play_animation(\"Hit\")

# -----------------
# DETECTION
# -----------------
func _on_detection_body_entered(body):
	if body.is_in_group(\"player\"):
		player = body

# -----------------
# ANIMATION FINISH
# -----------------
func _on_animation_finished(anim_name):
	if anim_name == \"Hit\":
		state = STATE_CHASE
	elif anim_name == \"Death\":
		emit_signal(\"boss_died\")
		queue_free()
	elif anim_name == \"Melee\":
		state = STATE_CHASE
	elif anim_name == \"BasicCast\":
		state = STATE_CHASE

# -----------------
# HELPER: PLAY ANIMATION
# -----------------
func _play_animation(name: String):
	if anim_player.current_animation != name:
		anim_player.play(name)
"

