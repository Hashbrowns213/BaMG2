[sub_resource type="GDScript" id="GDScript_tajxh"]
script/source = "extends CanvasLayer

func _ready() -> void:
	hide()
	process_mode = Node.PROCESS_MODE_ALWAYS


# ========================
# SHOW / HIDE
# ========================

func show_death_screen():
	show()
	get_tree().paused = true
	Hud.hide()


func hide_death_screen():
	hide()
	get_tree().paused = false
	Hud.show()


# ========================
# BUTTONS
# ========================

func _on_try_again_pressed() -> void:
	await change_scene_clean(\"res://Scenes/main.tscn\", true)


func _on_quit_pressed() -> void:
	await change_scene_clean(\"res://Scenes/main_menu.tscn\", false)


# ========================
# SAFE SCENE CHANGE
# ========================

func change_scene_clean(path: String, reset: bool) -> void:
	hide()

	# Unpause FIRST
	get_tree().paused = false

	# Let engine update pause state
	await get_tree().process_frame

	if reset:
		reset_stats()

	get_tree().change_scene_to_file(path)


# ========================
# RESET STATS
# ========================

func reset_stats():
	Stats.player_stats[\"health\"] = 100
	Stats.player_stats[\"lives\"] = 3
	Stats.player_stats[\"coins\"] = 0
"

