[sub_resource type="GDScript" id="GDScript_uyc1d"]
script/source = "extends Node2D

@onready var boss: Node = $\"Lord rodamA/CharacterBody2D\"
@onready var boss_ui: Node = $BossUI
@onready var player: Node = $Player  # Make sure this is the Player node instance in your scene

func _ready():
	# Connect player death signal safely
	if player and player.has_signal(\"player_died\"):
		player.connect(\"player_died\", Callable(self, \"_on_player_died\"))
	else:
		print(\"Warning: Player node not found or has no signal 'player_died'\")

	# Connect boss death signal safely
	if boss and boss.has_signal(\"boss_died\"):
		boss.connect(\"boss_died\", Callable(self, \"_on_boss_died\"))
	else:
		print(\"Warning: Boss node not found or has no signal 'boss_died'\")

# Player died: hide boss UI
func _on_player_died():
	if boss_ui:
		boss_ui.hide_ui()

# Boss died: change scene to victory
func _on_boss_died():
	print(\"Victory!\")
	SceneTransition.change_scene(\"res://Scenes/Victory.tscn\")

# Arena trigger: show boss UI
func _on_arena_trigger_body_entered(body: Node) -> void:
	if body.is_in_group(\"player\"):
		if boss_ui:
			boss_ui.setup(boss)
"

